					<input id="magic.{{@index}}.cn" value="{{magic.cn}}">
					<input id="magic.{{@index}}.range" value="{{magic.range}}">
					<input id="magic.{{@index}}.target" value="{{magic.target}}">
					<input id="magic.{{@index}}.duration" value="{{magic.duration}}">
					<input id="magic.{{@index}}.lore" value="{{magic.lore}}">
				</div>
			</div>
			{{/each}}
		</div>
	</div>

	<div class="card" data-flow-id="experience" data-add-type="experience" data-toggle="toggleExp">
		<h3>{{localize "SHEET.ExperienceLog"}}</h3>
		<div class="list-head experience">
			<span>{{localize "Experience"}}</span>
			<span>{{localize "Reason"}}</span>
		</div>
		<div class="content">
			{{#each status.experience.log as |experience|}}
			<div class="item experience">
				<div class="row-main">
					<input id="experience.{{@index}}.value" value="{{experience.value}}">
					<input class="col-rsn" id="experience.{{@index}}.reason" value="{{experience.reason}}">
				</div>
			</div>
			{{/each}}
		</div>
	</div>
</div>

<div id="generated-pages"></div>

<script type="application/json" id="props-data">{{{settings.propsJson}}}</script>
<script>
(() => {
	let debug = {{#if settings.debug}}true{{else}}false{{/if}};
	let debugMessage = ["%cWFRP4e - Print sheet %c[debug]%c.", "font-weight: bold;", "color: orange;", ""];
	let propsEl = document.getElementById("props-data");
	let props = {};
	try { props = JSON.parse(propsEl?.textContent || "{}"); } catch {};
	let tooltip = document.getElementById("tooltip");
	let flowPool = document.getElementById("flow-pool");
	let pagesHost = document.getElementById("generated-pages");
	let hoverTarget = null;
	let showTimer = null;
	let hideTimer = null;
	let mouseX = 0;
	let mouseY = 0;
	//Автоматическая разбивка разделов по листам A4: Таланты -> Броня и статус -> Оружие -> Имущество -> Магия -> Опыт
	function paginateFlowSections() {
		//Возврат элементов со старых страниц обратно в пул перед пересборкой
		pagesHost.querySelectorAll("[data-flow-id]").forEach(genEl => {
			let id = genEl.dataset.flowId;
			let poolEl = flowPool.querySelector(`:scope > [data-flow-id="${id}"]`);
			if (!poolEl) { return; }
			if (poolEl.dataset.atomic === "1") {
				while (genEl.firstChild) { poolEl.appendChild(genEl.firstChild) };
			} else {
				let poolContent = poolEl.querySelector(":scope > .content");
				genEl.querySelectorAll(":scope > .content > .item").forEach(item => poolContent.appendChild(item));
			}
		});
		pagesHost.innerHTML = "";
		let createPage = () => {
			let sec = document.createElement("section");
			sec.className = "sheet-page generated-page";
			pagesHost.appendChild(sec);
			return sec;
		};
		let createCardShell = (poolCard) => {
			let frame = document.createElement("div");
			frame.className = "frame";
			let card = document.createElement("div");
			card.className = "card";
			card.dataset.flowId = poolCard.dataset.flowId;
			if (poolCard.dataset.addType) { card.dataset.addType = poolCard.dataset.addType; }
			for (let child of poolCard.children) {
				if (child.classList.contains("content")) {
					let contentDiv = document.createElement("div");
					contentDiv.className = child.className;
					card.appendChild(contentDiv);
				} else {card.appendChild(child.cloneNode(true))};
			};
			frame.appendChild(card);
			return { frame, card, content: card.querySelector(":scope > .content") };
		};
		let currentPage = null;
		for (let poolNode of Array.from(flowPool.querySelectorAll(":scope > [data-flow-id]"))) {
			let toggleId = poolNode.dataset.toggle;
			if (toggleId && document.getElementById(toggleId)?.checked) { continue; }
			if (!currentPage) { currentPage = createPage(); }
			if (poolNode.dataset.atomic === "1") {
				let frame = document.createElement("div");
				frame.className = "frame";
				frame.dataset.flowId = poolNode.dataset.flowId;
				while (poolNode.firstChild) { frame.appendChild(poolNode.firstChild) };
				currentPage.appendChild(frame);
				if (currentPage.scrollHeight > currentPage.clientHeight + 2 && currentPage.children.length > 1) {
					frame.remove();
					currentPage = createPage();
					currentPage.appendChild(frame);
				};
				continue;
			};
			let items = Array.from(poolNode.querySelectorAll(":scope > .content > .item"));
			let shell = createCardShell(poolNode);
			currentPage.appendChild(shell.frame);
			if (currentPage.scrollHeight > currentPage.clientHeight + 2 && currentPage.children.length > 1) {
				shell.frame.remove();
				currentPage = createPage();
				currentPage.appendChild(shell.frame);
			};
			let idx = 0;
			while (idx < items.length) {
				let item = items[idx];
				shell.content.appendChild(item);
				if (currentPage.scrollHeight > currentPage.clientHeight + 2) {
					item.remove();
					let placedCount = shell.content.children.length;
					if (placedCount === 0 && currentPage.children.length > 1) {
						shell.frame.remove();
						currentPage = createPage();
						currentPage.appendChild(shell.frame);
						shell.content.appendChild(item);
						idx++;
					} else if (placedCount === 0) {
						shell.content.appendChild(item);
						idx++;
					} else {
						currentPage = createPage();
						shell = createCardShell(poolNode);
						currentPage.appendChild(shell.frame);
					};
				} else {idx++};
			};
		};
		if (debug) {
			console.debug(...debugMessage, "paginateFlowSections pages", pagesHost.children.length);
		};
	};
	//Пересчёт веса по категориям и монетам
	function round2(n) { return Math.round((Number(n) || 0) * 100) / 100; }
	function recalcEncumbrance(sourceInput = null) {
		let wEl = document.getElementById("encumbrance.weapons");
		let aEl = document.getElementById("encumbrance.armours");
		let tEl = document.getElementById("encumbrance.trappings");
		let totEl = document.getElementById("encumbrance.current");
		if (!wEl || !aEl || !tEl || !totEl) { return; }
		if (sourceInput && [wEl, aEl, tEl].includes(sourceInput)) {
			totEl.value = round2((parseFloat(wEl.value) || 0) + (parseFloat(aEl.value) || 0) + (parseFloat(tEl.value) || 0));
			return;
		};
		let sumSel = (sel) => round2(Array.from(document.querySelectorAll(sel)).reduce((s, inp) => s + (parseFloat(inp.value) || 0), 0));
		let wSum = sumSel(".item.weapons .col-enc");
		let aSum = sumSel(".item.armours .col-enc");
		let coinsTotal = (parseInt(document.getElementById("coins.gc")?.value) || 0)
			+ (parseInt(document.getElementById("coins.ss")?.value) || 0)
			+ (parseInt(document.getElementById("coins.bp")?.value) || 0);
		let coinsEnc = Math.floor(Math.max(0, coinsTotal) / 100);
		let tSum = round2(sumSel(".item.trappings:not(.layer) .col-enc") + coinsEnc);
		wEl.value = wSum;
		aEl.value = aSum;
		tEl.value = tSum;
		totEl.value = round2(wSum + aSum + tSum);
		if (debug) {
			console.debug(...debugMessage, "recalcEncumbrance", {weapons: wSum, armours: aSum, trappings: tSum, total: totEl.value});
		};
	};
	document.addEventListener("input", (e) => {
		if (e.target.classList.contains("col-enc") || ["coins.gc", "coins.ss", "coins.bp"].includes(e.target.id)) {recalcEncumbrance()}
		else if (["encumbrance.weapons", "encumbrance.armours", "encumbrance.trappings"].includes(e.target.id)) {recalcEncumbrance(e.target)};
	});
	let syncToggles = () => {
		document.body.classList.toggle("no-tooltips", document.getElementById("toggleTooltips").checked);
		document.body.classList.toggle("hide-sin", document.getElementById("toggleSin").checked);
		document.body.classList.toggle("mode-scale", document.getElementById("modeScale").checked);
		document.body.classList.toggle("mode-add", document.getElementById("modeAdd").checked);
		document.body.classList.toggle("mode-delete", document.getElementById("modeDelete").checked);
	};
	let modeIds = ["modeScale", "modeAdd", "modeDelete"];
	for (let id of modeIds) {
		document.getElementById(id).addEventListener("change", (e) => {
			if (e.target.checked) {
				for (let other of modeIds) {
					if (other !== id) {document.getElementById(other).checked = false};
				};
			};
			syncToggles();
		});
	}
	for (let id of ["toggleTooltips", "toggleSin"]) {
		document.getElementById(id).addEventListener("change", syncToggles);
	}
	for (let id of ["toggleMagic", "toggleExp"]) {
		document.getElementById(id).addEventListener("change", () => {
			syncToggles();
			paginateFlowSections();
		});
	};
	syncToggles();
	paginateFlowSections();
	let resizeTimer = null;
	window.addEventListener("resize", () => {
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(paginateFlowSections, 150);
	});
	window.addEventListener("beforeprint", paginateFlowSections);
	//Общее масштабирование шрифта
	let uiScale = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--ui-scale")) || 1;
	document.getElementById("btnScaleDown").addEventListener("click", () => {
		uiScale = Math.max(0.7, Math.round((uiScale - 0.05) * 100) / 100);
		document.documentElement.style.setProperty("--ui-scale", uiScale);
		paginateFlowSections();
	});
	document.getElementById("btnScaleUp").addEventListener("click", () => {
		uiScale = Math.min(1.4, Math.round((uiScale + 0.05) * 100) / 100);
		document.documentElement.style.setProperty("--ui-scale", uiScale);
		paginateFlowSections();
	});
	document.getElementById("btnPrint").addEventListener("click", () => {
		paginateFlowSections();
		window.print();
	});
	//Всплывающие подсказки у курсора с удержанием в границах экрана
	function buildTooltipHtml(target) {
		let html = "";
		let qualInput = target.querySelector("input[data-type='qualities']");
		let qualStr = (qualInput ? qualInput.value : (target.dataset.qualities || "")).trim();
		if (qualStr) {
			let list = qualStr.split(/\s*,\s*/).filter(Boolean);
			if (list.length) {
				html += "<h4>{{localize 'Qualities'}} &amp; {{localize 'Flaws'}}</h4>";
				for (let q of list) {
					let base = q.replace(/\s+\d+$/, "").trim();
					html += `<p><strong>${q}</strong>: ${props[base] || props[q] || "<em>{{localize 'WFRP4E.PrintSheet.Empty'}}</em>"}</p>`;
				};
			};
		};
		if (target.dataset.tooltip) {html += target.dataset.tooltip};
		return html;
	};
	function positionTooltip(x, y) {
		let pad = 10;
		let offset = 14;
		tooltip.style.left = "0px";
		tooltip.style.top = "0px";
		let tw = tooltip.offsetWidth;
		let th = tooltip.offsetHeight;
		let left = x + offset;
		if (left + tw > window.innerWidth - pad) {left = Math.max(pad, x - tw - offset)};
		left = Math.max(pad, Math.min(left, window.innerWidth - tw - pad));
		let top = y + offset;
		if (top + th > window.innerHeight - pad) {top = Math.max(pad, y - th - offset)};
		tooltip.style.left = `${Math.round(left)}px`;
		tooltip.style.top = `${Math.round(top)}px`;
	};
	document.addEventListener("mousemove", (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
	});
	document.addEventListener("mouseover", (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
		if (document.body.classList.contains("no-tooltips") || document.body.classList.contains("mode-scale") || document.body.classList.contains("mode-add") || document.body.classList.contains("mode-delete")) { return; }
		let target = e.target.closest(".tooltip-target");
		if (!target || target === hoverTarget) { return; }
		hoverTarget = target;
		clearTimeout(hideTimer);
		clearTimeout(showTimer);
		showTimer = setTimeout(() => {
			if (hoverTarget !== target) { return; }
			let content = buildTooltipHtml(target);
			if (!content) { return; }
			tooltip.innerHTML = content;
			tooltip.classList.add("active");
			positionTooltip(mouseX, mouseY);
		}, 350);
	});
	document.addEventListener("mouseout", (e) => {
		let target = e.target.closest(".tooltip-target");
		if (!target || target.contains(e.relatedTarget)) { return; }
		if (e.relatedTarget && tooltip.contains(e.relatedTarget)) { return; }
		clearTimeout(showTimer);
		hoverTarget = null;
		hideTimer = setTimeout(() => {
			if (!hoverTarget) { tooltip.classList.remove("active"); }
		}, 250);
	});
	tooltip.addEventListener("mouseenter", () => clearTimeout(hideTimer));
	tooltip.addEventListener("mouseleave", () => {
		hoverTarget = null;
		tooltip.classList.remove("active");
	});
	//Режимы масштабирования, добавления и удаления строк
	let charOptions = `
		<option value="ws" selected>{{localize "CHARAbbrev.WS"}}</option>
		<option value="bs">{{localize "CHARAbbrev.BS"}}</option>
		<option value="s">{{localize "CHARAbbrev.S"}}</option>
		<option value="t">{{localize "CHARAbbrev.T"}}</option>
		<option value="i">{{localize "CHARAbbrev.I"}}</option>
		<option value="ag">{{localize "CHARAbbrev.Ag"}}</option>
		<option value="dex">{{localize "CHARAbbrev.Dex"}}</option>
		<option value="int">{{localize "CHARAbbrev.Int"}}</option>
		<option value="wp">{{localize "CHARAbbrev.WP"}}</option>
		<option value="fel">{{localize "CHARAbbrev.Fel"}}</option>`;
	let rowTemplates = {
		skill: () => `<div class="item skills"><div class="row-main"><input class="col-name" value=""><select>${charOptions}</select><input value="0"><input value="0"><input value="0"></div></div>`,
		talent: () => `<div class="item talents"><div class="row-main"><div class="name-cell"><input value=""></div><input value=""><input value=""></div></div>`,
		armour: () => `<div class="item armours"><div class="row-main"><div class="name-cell"><input value=""></div><input value=""><input class="col-enc" value="0"><input data-type="qualities" value=""></div></div>`,
		weapon: () => `<div class="item weapons"><div class="row-main"><div class="name-cell"><input value=""></div><input value=""><input class="col-enc" value="0"><input value=""><input value=""><input data-type="qualities" value=""></div></div>`,
		trapping: () => `<div class="item trappings"><div class="row-main"><div class="name-cell"><input value=""></div><input class="col-enc" value="0"></div></div>`,
		magic: () => `<div class="item magics"><div class="row-main"><div class="name-cell"><input value=""></div><input value=""><input value=""><input value=""><input value=""><input value=""></div></div>`,
		experience: () => `<div class="item experience"><div class="row-main"><input value=""><input class="col-rsn" value=""></div></div>`,
		simple: () => `<div class="item simple"><div class="row-main"><div class="name-cell"><input value=""></div></div></div>`
	};
	document.addEventListener("click", (e) => {
		if (document.body.classList.contains("mode-scale")) {
			let field = e.target.closest("input:not([type=checkbox]), textarea");
			if (field) {
				let size = parseFloat(getComputedStyle(field).fontSize) || 12;
				field.style.fontSize = `${Math.min(28, size + 1)}px`;
				return;
			};
		};
		if (document.body.classList.contains("mode-delete")) {
			let row = e.target.closest(".content > .item");
			if (row) {
				let inFlow = Boolean(row.closest(".generated-page"));
				let affectsEnc = Boolean(row.querySelector(".col-enc"));
				row.remove();
				if (affectsEnc) { recalcEncumbrance(); }
				if (inFlow) { paginateFlowSections(); }
				return;
			};
		};
		if (document.body.classList.contains("mode-add")) {
			let heading = e.target.closest(".card[data-add-type] > h3");
			if (heading) {
				let card = heading.closest(".card");
				let type = card.dataset.addType;
				let container = card.querySelector(":scope > .content");
				if (container && rowTemplates[type]) {
					container.insertAdjacentHTML("beforeend", rowTemplates[type]());
					if (card.closest(".generated-page")) { paginateFlowSections(); }
				};
			};
		};
	});
	document.addEventListener("contextmenu", (e) => {
		if (!document.body.classList.contains("mode-scale")) { return; }
		let field = e.target.closest("input:not([type=checkbox]), textarea");
		if (field) {
			e.preventDefault();
			let size = parseFloat(getComputedStyle(field).fontSize) || 12;
			field.style.fontSize = `${Math.max(7, size - 1)}px`;
		};
	});
	//Сохранение изменённого листа в новый HTML-файл
	document.getElementById("btnSave").addEventListener("click", () => {
		tooltip.classList.remove("active");
		for (let id of modeIds) { document.getElementById(id).checked = false; }
		syncToggles();
		document.querySelectorAll("input").forEach(inp => {
			if (inp.type === "checkbox" || inp.type === "radio") {
				if (inp.checked) {inp.setAttribute("checked", "")}
				else {inp.removeAttribute("checked")};
			} else {inp.setAttribute("value", inp.value)};
		});
		document.querySelectorAll("textarea").forEach(ta => { ta.textContent = ta.value; });
		document.querySelectorAll("select").forEach(sel => {
			Array.from(sel.options).forEach(opt => {
				if (opt.selected) {opt.setAttribute("selected", "")}
				else {opt.removeAttribute("selected")};
			});
		});
		let html = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
		let blob = new Blob([html], {type: "text/html;charset=utf-8"});
		let filename = decodeURIComponent(window.location.pathname.split("/").pop() || "");
		if (!filename || !filename.toLowerCase().endsWith(".html")) {
			filename = ((document.getElementById("name")?.value || "character-sheet").replace(/[\/|\\:*?"<>]/g, "_")) + ".html";
		};
		let a = document.createElement("a");
		let url = URL.createObjectURL(blob);
		a.href = url;
		a.download = filename;
		document.body.appendChild(a);
		a.click();
		setTimeout(() => { a.remove(); URL.revokeObjectURL(url); }, 100);
	});
})();
</script>