<style>
	:root {
		--inputcolor: {{settings.inputcolor}};
		--ui-scale: 1;
		--gap: 0.25rem;
		--page-w: min(210mm, 96vw);
		--page-h: calc(var(--page-w) * 297 / 210);
		--color-large-border: #4a0404;
		--color-small-border: #564d3a;
		--parchment-bg: #f3ead3;
		--parchment-grad: radial-gradient(circle at 50% 40%, #f7f1df 0%, #eadcb9 100%);
	}
	*, *::before, *::after {
		box-sizing: border-box;
	}
	html {
		font-size: clamp(10.5px, 0.95vw, 13.5px);
		font-family: "Georgia", "Times New Roman", serif;
		background: #1b1815;
		color: #1c1610;
	}
	body {
		margin: 0 auto;
		padding: 0.75rem 0 2rem;
		width: var(--page-w);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		font-size: calc(0.84rem * var(--ui-scale));
	}



	.toolbar {
		position: sticky;
		top: 0.4rem;
		z-index: 50;
		width: 100%;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.65rem;
		background: rgba(24, 20, 17, 0.94);
		border: 1px solid #736953;
		border-radius: 0.45rem;
		box-shadow: 0 0.25rem 0.9rem rgba(0, 0, 0, 0.55);
	}
	.toolbar .tool-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		min-width: 2rem;
		height: 2rem;
		padding: 0 0.5rem;
		border: 1px solid #6b5f4a;
		border-radius: 0.3rem;
		background: #2b241d;
		color: #f0e6d2;
		cursor: pointer;
		font-size: 0.9rem;
		user-select: none;
		transition: background 0.15s, border-color 0.15s, color 0.15s;
	}
	.toolbar .tool-btn:hover {
		background: #42352a;
		border-color: #c8a253;
		color: #ffd700;
	}
	.toolbar input[type="checkbox"] {
		display: none;
	}
	.toolbar input[type="checkbox"]:checked + label.tool-btn {
		background: #4a0404;
		border-color: #d4a84f;
		color: #ffd700;
	}
	.toolbar .tool-sep {
		width: 1px;
		height: 1.4rem;
		background: #5a4f3d;
		margin: 0 0.15rem;
	}



	section.sheet-page {
		width: var(--page-w);
		height: var(--page-h);
		padding: 7.5mm 8mm;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		background-color: var(--parchment-bg);
		background-image:
			url("https://raw.githubusercontent.com/nPocToI4eJI/wfrp4e-print-sheet/refs/heads/main/Assets/background.png"),
			var(--parchment-grad);
		background-size: 100% 100%, cover;
		background-repeat: no-repeat;
		box-shadow: 0 0.4rem 1.5rem rgba(0, 0, 0, 0.65);
		border-radius: 0.25rem;
		overflow: hidden;
	}



	.frame {
		display: flex;
		flex-wrap: wrap;
		gap: var(--gap);
		padding: 0.22rem;
		border: 2px dotted var(--color-large-border);
		border-radius: 0.35rem;
		flex-shrink: 0;
	}
	.frame.grow {
		flex: 1 1 auto;
		min-height: 0;
	}
	.card {
		display: flex;
		flex-direction: column;
		border: 1px dashed var(--color-small-border);
		border-radius: 0.3rem;
		background: rgba(255, 252, 240, 0.32);
		box-shadow: inset 0 0 0.4rem rgba(70, 67, 49, 0.42);
		overflow: hidden;
		min-width: 0;
		width: 100%;
	}
	.card > h3 {
		margin: 0;
		padding: 0.2rem 0.4rem;
		text-align: center;
		font-size: 0.92em;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: #2b130a;
		border-bottom: 2px solid var(--color-small-border);
		background: rgba(74, 4, 4, 0.08);
		flex-shrink: 0;
	}



	input, textarea, select {
		font-family: inherit;
		font-size: 0.88em;
		font-weight: bold;
		color: var(--inputcolor);
		background: transparent;
		border: none;
		text-align: center;
		min-width: 0;
		width: 100%;
		padding: 0.08rem 0.18rem;
	}
	select {
		appearance: none;
		-webkit-appearance: none;
		cursor: pointer;
	}
	textarea {
		resize: none;
		text-align: left;
		line-height: 1.3;
		padding: 0.25rem 0.35rem;
		height: 100%;
	}
	input:focus, textarea:focus, select:focus {
		outline: none;
		background: rgba(255, 255, 255, 0.45);
	}
	@media not print {
		input:hover, textarea:hover, select:hover {
			background: rgba(255, 255, 255, 0.3);
		}
	}



	.details-grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: var(--gap);
		width: 100%;
	}
	.detail-field {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding: 0.12rem 0.28rem;
		border: 1px dashed var(--color-small-border);
		border-radius: 0.25rem;
		background: rgba(255, 252, 240, 0.32);
		min-height: 1.45rem;
	}
	.detail-field > span {
		font-weight: bold;
		font-size: 0.84em;
		white-space: nowrap;
		color: #2c2015;
	}
	.detail-field > input {
		text-align: right;
		flex: 1;
	}
	.span-2 { grid-column: span 2; }
	.span-3 { grid-column: span 3; }
	.span-4 { grid-column: span 4; }
	.span-5 { grid-column: span 5; }
	.span-9 { grid-column: span 9; }



	.status-grid {
		display: grid;
		grid-template-columns: 52% 1fr 1fr 1fr;
		grid-template-areas:
			"chars fate res sin"
			"chars exp exp move";
		gap: var(--gap);
		width: 100%;
	}
	body.hide-sin .status-grid {
		grid-template-areas:
			"chars fate res res"
			"chars exp exp move";
	}
	body.hide-sin .sin-card {
		display: none !important;
	}
	.char-table {
		width: 100%;
		border-collapse: collapse;
		table-layout: fixed;
		flex: 1;
	}
	.char-table th, .char-table td {
		border-bottom: 1px dashed var(--color-small-border);
		border-right: 1px dashed var(--color-small-border);
		padding: 0.08rem 0.05rem;
		text-align: center;
		font-size: 0.82em;
	}
	.char-table th:first-child, .char-table td:first-child {
		width: 18%;
		font-weight: bold;
		border-right: 2px solid var(--color-small-border);
	}
	.char-table thead th {
		border-bottom: 2px solid var(--color-small-border);
		font-weight: bold;
	}
	.char-table tr:last-child td { border-bottom: none; }
	.char-table td:last-child, .char-table th:last-child { border-right: none; }
	.stat-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.2rem;
		padding: 0.12rem 0.28rem;
		border-bottom: 1px dashed var(--color-small-border);
		flex: 1;
	}
	.stat-row:last-child { border-bottom: none; }
	.stat-row > span { font-size: 0.8em; font-weight: bold; white-space: nowrap; }
	.stat-row > input { text-align: right; flex: 1; }
	.stat-split {
		display: flex;
		flex: 1;
		border-bottom: 1px dashed var(--color-small-border);
	}
	.stat-split:last-child { border-bottom: none; }
	.stat-split > .stat-row {
		border-bottom: none;
		border-right: 1px dashed var(--color-small-border);
		flex: 1;
	}
	.stat-split > .stat-row:last-child { border-right: none; }



	.list-head {
		display: grid;
		align-items: stretch;
		width: 100%;
		font-weight: bold;
		font-size: 0.8em;
		text-align: center;
		border-bottom: 2px solid var(--color-small-border);
		background: rgba(74, 4, 4, 0.05);
		flex-shrink: 0;
	}
	.list-head > span {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.16rem 0.15rem;
		border-right: 1px dashed var(--color-small-border);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.list-head > span:last-child { border-right: none; }
	.content {
		display: flex;
		flex-direction: column;
		width: 100%;
		flex: 1;
	}
	.content > .item {
		border-bottom: 1px dashed var(--color-small-border);
		width: 100%;
	}
	.content > .item:last-child { border-bottom: none; }
	.item > .row-main {
		display: grid;
		align-items: stretch;
		width: 100%;
		min-height: 1.42rem;
	}
	.item > .row-main > * {
		border-right: 1px dashed var(--color-small-border);
		min-width: 0;
	}
	.item > .row-main > *:last-child { border-right: none; }
	.item > .row-main input,
	.item > .row-main select {
		font-size: 0.82em;
	}



	.name-cell {
		display: flex;
		align-items: center;
		gap: 0.18rem;
		padding-left: 0.15rem;
		min-width: 0;
		overflow: hidden;
	}
	.name-cell > input {
		text-align: left;
		flex: 1 1 auto;
		min-width: 0;
	}
	.item-icon {
		width: 1.18rem;
		height: 1.18rem;
		object-fit: contain;
		flex: 0 0 1.18rem;
	}



	.skills-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--gap);
		width: 100%;
		align-items: stretch;
	}
	.list-head.skills {
		grid-template-columns: 44% 28% 14% 14%;
	}
	.item.skills > .row-main {
		grid-template-columns: 44% 14% 14% 14% 14%;
	}
	.item.skills > .row-main > .col-name { text-align: left; padding-left: 0.22rem; }
	.list-head.armours,
	.item.armours > .row-main {
		grid-template-columns: 28% 32% 10% 30%;
	}
	.list-head.weapons,
	.item.weapons > .row-main {
		grid-template-columns: 26% 15% 8% 14% 9% 28%;
	}
	.list-head.trappings,
	.item.trappings > .row-main {
		grid-template-columns: 84% 16%;
	}
	.item.trappings.layer .name-cell {
		padding-left: calc(0.15rem + var(--indent, 1) * 0.7rem);
	}
	.item.trappings.layer .name-cell::before {
		content: "•";
		flex: 0 0 auto;
		font-weight: bold;
		color: #4a0404;
	}
	.list-head.magics,
	.item.magics > .row-main {
		grid-template-columns: 30% 7% 15% 15% 15% 18%;
	}
	.list-head.experience,
	.item.experience > .row-main {
		grid-template-columns: 16% 84%;
	}
	.item.experience .col-rsn { text-align: left; padding-left: 0.3rem; }
	.item.simple > .row-main {
		grid-template-columns: 100%;
	}



	.talents-head-pair {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-bottom: 2px solid var(--color-small-border);
		background: rgba(74, 4, 4, 0.05);
	}
	.talents-head-pair > .list-head.talents {
		border-bottom: none;
		background: transparent;
	}
	.talents-head-pair > .list-head.talents:first-child {
		border-right: 2px solid var(--color-small-border);
	}
	.list-head.talents,
	.item.talents > .row-main {
		grid-template-columns: 40% 13% 47%;
	}
	.content.talents-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-content: start;
		margin-bottom: -1px;
	}
	.content.talents-grid > .item,
	.content.talents-grid > .item:last-child {
		border-bottom: 1px dashed var(--color-small-border);
	}
	.content.talents-grid > .item:nth-child(odd) {
		border-right: 2px solid var(--color-small-border);
	}



	.amb-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--gap);
		width: 100%;
	}
	.bio-card {
		flex: 1 1 auto;
		height: 100%;
	}
	.bio-card > textarea {
		flex: 1 1 auto;
		min-height: 4rem;
	}
	.amb-row {
		display: flex;
		align-items: stretch;
		border-bottom: 1px dashed var(--color-small-border);
		flex: 1;
	}
	.amb-row:last-child { border-bottom: none; }
	.amb-row > span {
		width: 30%;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		font-size: 0.78em;
		font-weight: bold;
		padding: 0.2rem;
		border-right: 1px dashed var(--color-small-border);
	}
	.amb-row > textarea {
		width: 70%;
		min-height: 2.2rem;
	}



	.combat-top-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 32%;
		grid-template-areas:
			"armour armour portrait"
			"psych mut wounds"
			"coins enc wounds";
		gap: var(--gap);
		width: 100%;
	}
	.portrait-card {
		grid-area: portrait;
		align-items: center;
		justify-content: center;
		padding: 0.35rem;
		min-height: 10.5rem;
	}
	.portrait-card img {
		max-width: 100%;
		max-height: 11.5rem;
		object-fit: contain;
		border-radius: 0.25rem;
	}
	.coin-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.18rem 0.45rem;
		border-bottom: 1px dashed var(--color-small-border);
		flex: 1;
	}
	.coin-row:last-child { border-bottom: none; }
	.coin-row input { font-size: 1.12em; width: 55%; }
	.coin-row img { width: 1.55rem; height: 1.55rem; object-fit: contain; }
	.coin-row span { font-weight: bold; }
	.wounds-header {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		padding: 0.18rem 0.4rem;
		border-bottom: 2px solid var(--color-small-border);
		font-weight: bold;
		font-size: 0.98em;
	}
	.wounds-header input { width: 3.2rem; font-size: 1.08em; }



	body.mode-scale input, body.mode-scale textarea {
		cursor: ns-resize !important;
		box-shadow: inset 0 0 0.35rem rgba(139, 0, 0, 0.7);
	}
	body.mode-add .card[data-add-type] > h3 {
		cursor: pointer !important;
		box-shadow: inset 0 0 0.45rem rgba(0, 110, 0, 0.75);
	}
	body.mode-delete .content > .item {
		cursor: pointer !important;
		box-shadow: inset 0 0 0.35rem rgba(160, 0, 0, 0.65);
	}



	.tooltip {
		position: fixed;
		z-index: 100;
		padding: 0.5rem 0.65rem;
		max-width: min(32rem, 90vw);
		max-height: 65vh;
		overflow-y: auto;
		background-color: #f3ead3;
		background-image: url("https://raw.githubusercontent.com/nPocToI4eJI/wfrp4e-print-sheet/refs/heads/main/Assets/tooltip.png");
		border: 2px solid #736953;
		border-radius: 0.4rem;
		box-shadow: 0 0.35rem 1.2rem rgba(0, 0, 0, 0.55);
		font-size: 0.85rem;
		line-height: 1.35;
		color: #1c1610;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.15s ease, visibility 0.15s ease;
	}
	.tooltip.active {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}
	.tooltip h4 { margin: 0.35rem 0 0.25rem; text-align: center; border-bottom: 1px solid #736953; }
	.tooltip p { margin: 0.25rem 0; }
	.tooltip .range-table-wrap { display: flex; justify-content: center; margin: 0.3rem 0; }
	.tooltip .range-table { border-collapse: collapse; border: 1px solid var(--color-large-border); font-size: 0.85em; }
	.tooltip .range-table th, .tooltip .range-table td { border: 1px dashed var(--color-small-border); padding: 0.15rem 0.3rem; text-align: center; }
	body.no-tooltips .tooltip,
	body.mode-scale .tooltip,
	body.mode-add .tooltip,
	body.mode-delete .tooltip {
		display: none !important;
	}



	@page {
		size: A4 portrait;
		margin: 0;
	}
	@media print {
		:root {
			--page-w: 210mm;
			--page-h: 297mm;
		}
		html {
			font-size: 9.5pt;
			background: #fff;
		}
		body {
			width: 210mm;
			margin: 0;
			padding: 0;
			gap: 0;
		}
		.toolbar, .tooltip, #flow-pool {
			display: none !important;
		}
		section.sheet-page {
			width: 210mm;
			height: 297mm;
			padding: 7.5mm 8mm;
			margin: 0;
			box-shadow: none;
			border-radius: 0;
			break-after: page;
			page-break-after: always;
			-webkit-print-color-adjust: exact;
			print-color-adjust: exact;
		}
		section.sheet-page:last-of-type {
			break-after: auto;
			page-break-after: auto;
		}
		.frame, .card { box-shadow: none; }
	}
</style>

<div class="tooltip" id="tooltip"></div>

<div class="toolbar" id="toolbar">
	<button type="button" class="tool-btn" id="btnPrint" title="{{localize 'WFRP4E.PrintSheet.HTML.Print'}}"><i class="fas fa-print"></i></button>
	<button type="button" class="tool-btn" id="btnSave" title="{{localize 'WFRP4E.PrintSheet.HTML.Save'}}"><i class="fas fa-save"></i></button>
	<span class="tool-sep"></span>
	<input type="checkbox" id="toggleTooltips">
	<label class="tool-btn" for="toggleTooltips" title="{{localize 'WFRP4E.PrintSheet.HTML.HideTooltip'}}"><i class="fas fa-info-circle"></i></label>
	<input type="checkbox" id="toggleMagic"{{#unless settings.showMagic}} checked{{/unless}}>
	<label class="tool-btn" for="toggleMagic" title="{{localize 'WFRP4E.PrintSheet.HTML.HideMagics'}}"><i class="fas fa-scroll"></i></label>
	<input type="checkbox" id="toggleSin"{{#unless settings.showSin}} checked{{/unless}}>
	<label class="tool-btn" for="toggleSin" title="{{localize 'WFRP4E.PrintSheet.HTML.HideSin'}}"><i class="fas fa-star"></i></label>
	<input type="checkbox" id="toggleExp"{{#unless settings.showExperience}} checked{{/unless}}>
	<label class="tool-btn" for="toggleExp" title="{{localize 'WFRP4E.PrintSheet.HTML.HideExperience'}}"><i class="fas fa-book"></i></label>
	<span class="tool-sep"></span>
	<button type="button" class="tool-btn" id="btnScaleDown" title="{{localize 'WFRP4E.PrintSheet.HTML.ScaleGlobalDown'}}">A-</button>
	<button type="button" class="tool-btn" id="btnScaleUp" title="{{localize 'WFRP4E.PrintSheet.HTML.ScaleGlobalUp'}}">A+</button>
	<input type="checkbox" id="modeScale">
	<label class="tool-btn" for="modeScale" title="{{localize 'WFRP4E.PrintSheet.HTML.ScaleFont'}}"><i class="fas fa-text-height"></i></label>
	<input type="checkbox" id="modeAdd">
	<label class="tool-btn" for="modeAdd" title="{{localize 'WFRP4E.PrintSheet.HTML.Add'}}"><i class="fas fa-plus"></i></label>
	<input type="checkbox" id="modeDelete">
	<label class="tool-btn" for="modeDelete" title="{{localize 'WFRP4E.PrintSheet.HTML.Delete'}}"><i class="fas fa-trash"></i></label>
</div>

<section class="sheet-page">
	<div class="frame">
		<div class="details-grid">
			<div class="detail-field span-5">
				<span>{{localize "Name"}}</span>
				<input id="name" value="{{name}}"{{#if player}} class="tooltip-target" data-tooltip="<p>{{localize 'Owner'}}: {{player}}</p>"{{/if}}>
			</div>
			<div class="detail-field span-4">
				<span>{{localize "Species"}}</span>
				<input id="details.race" value="{{details.race}}">
			</div>
			<div class="detail-field span-3">
				<span>{{localize "Gender"}}</span>
				<input id="details.gender" value="{{details.gender}}">
			</div>

			<div class="detail-field span-4">
				<span>{{localize "Class"}}</span>
				<input id="career.class" value="{{career.class}}">
			</div>
			<div class="detail-field span-5">
				<span>{{localize "Career"}}</span>
				<input id="career.name" value="{{career.name}}">
			</div>
			<div class="detail-field span-3">
				<span>{{localize "Career Level"}}</span>
				<input id="career.level" value="{{career.level}}">
			</div>

			<div class="detail-field span-9">
				<span>{{localize "WFRP4E.PrintSheet.HTML.CareerPath"}}</span>
				<input id="career.path" value="{{career.path}}">
			</div>
			<div class="detail-field span-3">
				<span>{{localize "Status"}}</span>
				<input id="career.status" value="{{career.status}}">
			</div>

			<div class="detail-field span-2">
				<span>{{localize "Age"}}</span>
				<input id="details.age" value="{{details.age}}">
			</div>
			<div class="detail-field span-4">
				<span>{{localize "CharacterHeight"}} ({{localize "Weight"}})</span>
				<input id="details.height_weight" value="{{details.heightWeight}}">
			</div>
			<div class="detail-field span-3">
				<span>{{localize "Hair Colour"}}</span>
				<input id="details.haircolour" value="{{details.haircolour}}">
			</div>
