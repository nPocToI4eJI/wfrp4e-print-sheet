<style>
	:root {
		--inputcolor: {{settings.inputcolor}};
		--ui-scale: 1;
		--gap: 0.6rem;
		--color-large-border: #4a0404;
		--color-small-border: #6c5e44;
		--parchment-bg: #f3ead3;
		--parchment-card: rgba(255, 251, 238, 0.72);
		--ink: #1d1711;
		--gold: #d4a84f;
	}
	*, *::before, *::after {
		box-sizing: border-box;
	}
	html {
		font-size: clamp(13px, 1vw, 16px);
		font-family: "Georgia", "Times New Roman", serif;
		background: #181410;
		color: var(--ink);
	}
	body {
		margin: 0;
		padding: 0 0 2.5rem;
		min-height: 100vh;
		font-size: calc(0.95rem * var(--ui-scale));
		background-color: #181410;
	}



	.topbar {
		position: sticky;
		top: 0;
		z-index: 60;
		background: rgba(24, 20, 16, 0.96);
		border-bottom: 2px solid var(--color-large-border);
		box-shadow: 0 0.25rem 1rem rgba(0, 0, 0, 0.6);
		padding: 0.5rem clamp(0.5rem, 2vw, 1.5rem);
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}
	.topbar-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.45rem;
		max-width: 92rem;
		width: 100%;
		margin: 0 auto;
	}
	.nav-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}
	.nav-tab {
		padding: 0.35rem 0.7rem;
		border: 1px solid #6b5f4a;
		border-radius: 0.3rem;
		background: #2b241d;
		color: #e8dcc4;
		font-family: inherit;
		font-size: 0.85rem;
		font-weight: bold;
		cursor: pointer;
		transition: background 0.15s, border-color 0.15s, color 0.15s;
	}
	.nav-tab:hover { background: #3e3328; border-color: var(--gold); }
	.nav-tab.active { background: var(--color-large-border); border-color: var(--gold); color: #ffd700; }
	.search-wrap {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		background: #2b241d;
		border: 1px solid #6b5f4a;
		border-radius: 0.3rem;
		padding: 0.15rem 0.5rem;
		flex: 1 1 12rem;
		max-width: 22rem;
		color: #c9bca5;
	}
	.search-wrap input {
		background: transparent;
		border: none;
		color: #f7efe0;
		text-align: left;
		font-weight: normal;
		font-size: 0.88rem;
		padding: 0.2rem;
	}
	.search-wrap input:focus { background: transparent; outline: none; box-shadow: none; }
	.tools-group {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem;
	}
	.tool-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2rem;
		height: 2rem;
		padding: 0 0.45rem;
		border: 1px solid #6b5f4a;
		border-radius: 0.3rem;
		background: #2b241d;
		color: #f0e6d2;
		cursor: pointer;
		font-size: 0.88rem;
		user-select: none;
		transition: background 0.15s, border-color 0.15s, color 0.15s;
	}
	.tool-btn:hover { background: #42352a; border-color: var(--gold); color: #ffd700; }
	.tools-group input[type="checkbox"] { display: none; }
	.tools-group input[type="checkbox"]:checked + label.tool-btn { background: var(--color-large-border); border-color: var(--gold); color: #ffd700; }
	.tool-sep { width: 1px; height: 1.35rem; background: #5a4f3d; margin: 0 0.1rem; }



	.sheet-container {
		max-width: min(92rem, 96vw);
		margin: 1rem auto 0;
		padding: clamp(0.65rem, 1.6vw, 1.3rem);
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		background-color: var(--parchment-bg);
		background-image: radial-gradient(circle at 50% 25%, #f7f1df 0%, #e7d7b2 100%);
		border: 3px double var(--color-large-border);
		border-radius: 0.5rem;
		box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.7);
	}



	.hero-bar {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.85rem;
		align-items: stretch;
		padding: 0.55rem;
		border: 2px dotted var(--color-large-border);
		border-radius: 0.45rem;
		background: rgba(255, 251, 238, 0.45);
	}
	.hero-portrait {
		width: clamp(5.5rem, 10vw, 8.5rem);
		height: clamp(5.5rem, 10vw, 8.5rem);
		border: 2px solid var(--color-small-border);
		border-radius: 0.4rem;
		background: rgba(0, 0, 0, 0.08);
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		align-self: center;
	}
	.hero-portrait img { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; padding: 0.15rem; }
	.hero-portrait.empty { display: none; }
	.hero-details {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
		gap: 0.35rem;
	}
	.detail-field {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.2rem 0.45rem;
		border: 1px dashed var(--color-small-border);
		border-radius: 0.3rem;
		background: var(--parchment-card);
	}
	.detail-field > span { font-weight: bold; font-size: 0.85em; white-space: nowrap; color: #3a2a1a; }
	.detail-field > input { text-align: right; flex: 1; }
	.detail-field.wide { grid-column: span 2; }



	.tab-section { display: flex; flex-direction: column; gap: 0.85rem; }
	.tab-section[hidden], .card[hidden], .grid-2[hidden], .grid-3[hidden], .grid-status[hidden] { display: none !important; }
	.grid-2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr)); gap: var(--gap); }
	.grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr)); gap: var(--gap); }
	.grid-status { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(12.5rem, 100%), 1fr)); gap: var(--gap); }
	.card {
		display: flex;
		flex-direction: column;
		border: 1px dashed var(--color-small-border);
		border-radius: 0.4rem;
		background: var(--parchment-card);
		box-shadow: inset 0 0 0.45rem rgba(70, 67, 49, 0.35);
		overflow: hidden;
		min-width: 0;
	}
	.card > h3 {
		margin: 0;
		padding: 0.4rem 0.65rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		font-size: 1em;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: #2b130a;
		border-bottom: 2px solid var(--color-small-border);
		background: rgba(74, 4, 4, 0.1);
	}
	.card > h3 .badge {
		font-size: 0.78em;
		padding: 0.05rem 0.4rem;
		border-radius: 999px;
		background: rgba(74, 4, 4, 0.16);
		color: #4a0404;
	}



	input, textarea, select {
		font-family: inherit;
		font-size: 0.92em;
		font-weight: bold;
		color: var(--inputcolor);
		background: transparent;
		border: none;
		text-align: center;
		min-width: 0;
		width: 100%;
		padding: 0.2rem 0.25rem;
	}
	select { appearance: none; -webkit-appearance: none; cursor: pointer; }
	textarea { resize: vertical; text-align: left; line-height: 1.4; padding: 0.4rem 0.55rem; min-height: 8rem; }
	.card > textarea { flex: 1 1 auto; height: 100%; min-height: 12rem; }
	input:hover, textarea:hover, select:hover { background: rgba(255, 255, 255, 0.4); }
	input:focus, textarea:focus, select:focus { outline: none; background: rgba(255, 255, 255, 0.7); box-shadow: inset 0 0 0 1px var(--color-small-border); }



	.char-wrap { overflow-x: auto; }
	.char-table { width: 100%; border-collapse: collapse; min-width: 30rem; table-layout: fixed; }
	.char-table th, .char-table td { border-bottom: 1px dashed var(--color-small-border); border-right: 1px dashed var(--color-small-border); padding: 0.25rem 0.15rem; text-align: center; }
	.char-table th:first-child, .char-table td:first-child { width: 16%; font-weight: bold; border-right: 2px solid var(--color-small-border); }
	.char-table thead th { border-bottom: 2px solid var(--color-small-border); background: rgba(74, 4, 4, 0.05); }
	.char-table tr.bonus-row td { background: rgba(74, 4, 4, 0.04); font-size: 0.85em; }
	.char-table tr:last-child td { border-bottom: none; }
	.char-table td:last-child, .char-table th:last-child { border-right: none; }



	.stat-row { display: flex; align-items: center; justify-content: space-between; gap: 0.35rem; padding: 0.25rem 0.5rem; border-bottom: 1px dashed var(--color-small-border); }
	.stat-row:last-child { border-bottom: none; }
	.stat-row > span { font-size: 0.88em; font-weight: bold; white-space: nowrap; }
	.stat-row > input { text-align: right; flex: 1; }
	.stepper { display: inline-flex; align-items: center; gap: 0.2rem; }
	.stepper input { width: 3.4rem; text-align: center; }
	.step-btn {
		width: 1.5rem;
		height: 1.5rem;
		padding: 0;
		border: 1px solid var(--color-small-border);
		border-radius: 0.25rem;
		background: rgba(74, 4, 4, 0.1);
		color: #2b130a;
		font-weight: bold;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}
	.step-btn:hover { background: var(--color-large-border); color: #fff; }



	.list-head {
		display: grid;
		align-items: stretch;
		width: 100%;
		font-weight: bold;
		font-size: 0.84em;
		text-align: center;
		border-bottom: 2px solid var(--color-small-border);
		background: rgba(74, 4, 4, 0.05);
	}
	.list-head > span {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.28rem 0.2rem;
		border-right: 1px dashed var(--color-small-border);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.list-head > span:last-child { border-right: none; }
	.content { display: flex; flex-direction: column; width: 100%; }
	.content > .item { display: flex; flex-direction: column; border-bottom: 1px dashed var(--color-small-border); }
	.content > .item:last-child { border-bottom: none; }
	.content > .item[hidden] { display: none !important; }
	.item > .row-main { display: grid; align-items: stretch; width: 100%; }
	.item > .row-main > * { border-right: 1px dashed var(--color-small-border); min-width: 0; }
	.item > .row-main > *:last-child { border-right: none; }
	.name-cell { display: flex; align-items: center; gap: 0.3rem; padding-left: 0.3rem; min-width: 0; overflow: hidden; }
	.name-cell > input { text-align: left; flex: 1 1 auto; min-width: 0; }
	.item-icon { width: 1.45rem; height: 1.45rem; object-fit: contain; flex: 0 0 1.45rem; border-radius: 0.2rem; }
	.expand-btn {
		border: none;
		background: transparent;
		color: #6b583c;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.9em;
		padding: 0;
	}
	.expand-btn:hover, .item.expanded .expand-btn { color: var(--color-large-border); }
	.inline-desc { padding: 0.45rem 0.75rem; background: rgba(235, 222, 189, 0.65); border-top: 1px dotted var(--color-small-border); font-size: 0.88em; line-height: 1.4; }
	.inline-desc[hidden] { display: none !important; }
	.inline-desc h4 { margin: 0.3rem 0 0.2rem; font-size: 0.95em; color: var(--color-large-border); }
	.inline-desc p { margin: 0.25rem 0; }
	.inline-desc .range-table-wrap { display: flex; justify-content: center; margin: 0.35rem 0; }
	.inline-desc .range-table { border-collapse: collapse; border: 1px solid var(--color-large-border); font-size: 0.88em; }
	.inline-desc .range-table th, .inline-desc .range-table td { border: 1px dashed var(--color-small-border); padding: 0.2rem 0.4rem; text-align: center; }



	.list-head.skills { grid-template-columns: 1fr 26% 13% 13% 1.85rem; }
	.item.skills > .row-main { grid-template-columns: 1fr 13% 13% 13% 13% 1.85rem; }
	.item.skills > .row-main > .col-name { text-align: left; padding-left: 0.4rem; }
	.content.talents-columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr)); gap: 0; width: calc(100% + 2px); margin-bottom: -1px; }
	.content.talents-columns > .item,
	.content.talents-columns > .item:last-child { border-bottom: 1px dashed var(--color-small-border); border-right: 2px solid var(--color-small-border); }
	.list-head.talents, .item.talents > .row-main { grid-template-columns: 38% 14% 1fr 1.85rem; }
	.list-head.armours, .item.armours > .row-main { grid-template-columns: 28% 28% 10% 1fr 1.85rem; }
	.list-head.weapons, .item.weapons > .row-main { grid-template-columns: 25% 15% 8% 13% 9% 1fr 1.85rem; }
	.list-head.trappings, .item.trappings > .row-main { grid-template-columns: 1fr 16% 1.85rem; }
	.item.trappings.layer .name-cell { padding-left: calc(0.3rem + var(--indent, 1) * 0.9rem); }
	.item.trappings.layer .name-cell::before { content: "•"; flex: 0 0 auto; font-weight: bold; color: #4a0404; }
	.list-head.magics, .item.magics > .row-main { grid-template-columns: 28% 7% 15% 15% 14% 1fr 1.85rem; }
	.list-head.experience, .item.experience > .row-main { grid-template-columns: 18% 1fr; }
	.item.experience .col-rsn { text-align: left; padding-left: 0.4rem; }
	.item.simple > .row-main { grid-template-columns: 1fr 1.85rem; }
	.coin-icon { width: 1.5rem; height: 1.5rem; object-fit: contain; }



	body.hide-sin .sin-card { display: none !important; }
	body.hide-magic .magic-section { display: none !important; }
	body.hide-exp .exp-section { display: none !important; }
	body.mode-scale input, body.mode-scale textarea { cursor: ns-resize !important; box-shadow: inset 0 0 0.35rem rgba(139, 0, 0, 0.7); }
	body.mode-add .card[data-add-type] > h3 { cursor: pointer !important; box-shadow: inset 0 0 0.45rem rgba(0, 110, 0, 0.75); }
	body.mode-delete .content > .item { cursor: pointer !important; box-shadow: inset 0 0 0.35rem rgba(160, 0, 0, 0.65); }



	.tooltip {
		position: fixed;
		z-index: 100;
		padding: 0.55rem 0.7rem;
		max-width: min(34rem, 90vw);
		max-height: 65vh;
		overflow-y: auto;
		background-color: #f3ead3;
		background-image: url("https://raw.githubusercontent.com/nPocToI4eJI/wfrp4e-print-sheet/refs/heads/main/Assets/tooltip.png");
		border: 2px solid #736953;
		border-radius: 0.4rem;
		box-shadow: 0 0.35rem 1.2rem rgba(0, 0, 0, 0.55);
		font-size: 0.88rem;
		line-height: 1.4;
		color: var(--ink);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.15s ease, visibility 0.15s ease;
	}
	.tooltip.active { opacity: 1; visibility: visible; pointer-events: auto; }
	.tooltip h4 { margin: 0.35rem 0 0.25rem; text-align: center; border-bottom: 1px solid #736953; }
	.tooltip p { margin: 0.25rem 0; }
	.tooltip .range-table-wrap { display: flex; justify-content: center; margin: 0.3rem 0; }
	.tooltip .range-table { border-collapse: collapse; border: 1px solid var(--color-large-border); font-size: 0.85em; }
	.tooltip .range-table th, .tooltip .range-table td { border: 1px dashed var(--color-small-border); padding: 0.15rem 0.3rem; text-align: center; }
	body.no-tooltips .tooltip, body.mode-scale .tooltip, body.mode-add .tooltip, body.mode-delete .tooltip { display: none !important; }
	@media (max-width: 48rem) {
		.hero-bar { grid-template-columns: 1fr; }
		.hero-portrait { margin: 0 auto; }
		.detail-field.wide { grid-column: span 1; }
	}
	@media print {
		.topbar, .tooltip, .expand-btn, .step-btn { display: none !important; }
		html, body { background: #fff; padding: 0; }
		.sheet-container { max-width: 100%; margin: 0; border: none; box-shadow: none; }
		.tab-section { display: flex !important; }
	}
</style>

<div class="tooltip" id="tooltip"></div>

<header class="topbar">
	<div class="topbar-row">
		<nav class="nav-tabs" id="navTabs">
			<button type="button" class="nav-tab active" data-tab="all">{{localize "WFRP4E.PrintSheet.HTML.Tabs.All"}}</button>
			<button type="button" class="nav-tab" data-tab="main">{{localize "WFRP4E.PrintSheet.HTML.Tabs.Main"}}</button>
			<button type="button" class="nav-tab" data-tab="talents">{{localize "WFRP4E.PrintSheet.HTML.Tabs.Talents"}}</button>
			<button type="button" class="nav-tab" data-tab="combat">{{localize "WFRP4E.PrintSheet.HTML.Tabs.Combat"}}</button>
			<button type="button" class="nav-tab" data-tab="magic">{{localize "WFRP4E.PrintSheet.HTML.Tabs.Magic"}}</button>
		</nav>
		<div class="search-wrap">
			<i class="fas fa-search"></i>
			<input type="search" id="sheetSearch" placeholder="{{localize 'WFRP4E.PrintSheet.HTML.SearchPlaceholder'}}">
		</div>
		<div class="tools-group">
			<button type="button" class="tool-btn" id="btnSave" title="{{localize 'WFRP4E.PrintSheet.HTML.Save'}}"><i class="fas fa-save"></i></button>
			<button type="button" class="tool-btn" id="btnPrint" title="{{localize 'WFRP4E.PrintSheet.HTML.Print'}}"><i class="fas fa-print"></i></button>
			<span class="tool-sep"></span>
			<input type="checkbox" id="toggleTooltips">
			<label class="tool-btn" for="toggleTooltips" title="{{localize 'WFRP4E.PrintSheet.HTML.HideTooltip'}}"><i class="fas fa-info-circle"></i></label>
			<input type="checkbox" id="toggleMagic"{{#unless settings.showMagic}} checked{{/unless}}>
			<label class="tool-btn" for="toggleMagic" title="{{localize 'WFRP4E.PrintSheet.HTML.HideMagics'}}"><i class="fas fa-scroll"></i></label>
			<input type="checkbox" id="toggleSin"{{#unless settings.showSin}} checked{{/unless}}>
			<label class="tool-btn" for="toggleSin" title="{{localize 'WFRP4E.PrintSheet.HTML.HideSin'}}"><i class="fas fa-star"></i></label>
			<input type="checkbox" id="toggleExp"{{#unless settings.showExperience}} checked{{/unless}}>
			<label class="tool-btn" for="toggleExp" title="{{localize 'WFRP4E.PrintSheet.HTML.HideExperience'}}"><i class="fas fa-book"></i></label>
			<span class="tool-sep"></span>
			<button type="button" class="tool-btn" id="btnScaleDown" title="{{localize 'WFRP4E.PrintSheet.HTML.ScaleGlobalDown'}}">A-</button>
			<button type="button" class="tool-btn" id="btnScaleUp" title="{{localize 'WFRP4E.PrintSheet.HTML.ScaleGlobalUp'}}">A+</button>
			<input type="checkbox" id="modeScale">
			<label class="tool-btn" for="modeScale" title="{{localize 'WFRP4E.PrintSheet.HTML.ScaleFont'}}"><i class="fas fa-text-height"></i></label>
			<input type="checkbox" id="modeAdd">
			<label class="tool-btn" for="modeAdd" title="{{localize 'WFRP4E.PrintSheet.HTML.Add'}}"><i class="fas fa-plus"></i></label>
			<input type="checkbox" id="modeDelete">
			<label class="tool-btn" for="modeDelete" title="{{localize 'WFRP4E.PrintSheet.HTML.Delete'}}"><i class="fas fa-trash"></i></label>
		</div>
	</div>
</header>

<main class="sheet-container">
	<div class="hero-bar">
		<div class="hero-portrait{{#unless image}} empty{{/unless}}">
			{{#if image}}<img src="{{image}}" alt="{{name}}">{{/if}}
		</div>
		<div class="hero-details">
			<div class="detail-field"><span>{{localize "Name"}}</span><input id="name" value="{{name}}"{{#if player}} class="tooltip-target" data-tooltip="<p>{{localize 'Owner'}}: {{player}}</p>"{{/if}}></div>
			<div class="detail-field"><span>{{localize "Species"}}</span><input id="details.race" value="{{details.race}}"></div>
			<div class="detail-field"><span>{{localize "Gender"}}</span><input id="details.gender" value="{{details.gender}}"></div>
			<div class="detail-field"><span>{{localize "Class"}}</span><input id="career.class" value="{{career.class}}"></div>
			<div class="detail-field"><span>{{localize "Career"}}</span><input id="career.name" value="{{career.name}}"></div>
			<div class="detail-field"><span>{{localize "Career Level"}}</span><input id="career.level" value="{{career.level}}"></div>
			<div class="detail-field wide"><span>{{localize "WFRP4E.PrintSheet.HTML.CareerPath"}}</span><input id="career.path" value="{{career.path}}"></div>
			<div class="detail-field"><span>{{localize "Status"}}</span><input id="career.status" value="{{career.status}}"></div>
			<div class="detail-field"><span>{{localize "Age"}}</span><input id="details.age" value="{{details.age}}"></div>
			<div class="detail-field"><span>{{localize "CharacterHeight"}} ({{localize "Weight"}})</span><input id="details.height_weight" value="{{details.heightWeight}}"></div>
			<div class="detail-field"><span>{{localize "Hair Colour"}}</span><input id="details.haircolour" value="{{details.haircolour}}"></div>
			<div class="detail-field"><span>{{localize "Eye Colour"}}</span><input id="details.eyecolour" value="{{details.eyecolour}}"></div>
		</div>
	</div>

	<section class="tab-section" data-section="main">
		<div class="card">
			<h3>{{localize "Characteristics"}}</h3>
			<div class="char-wrap">
				<table class="char-table">
					<thead>
						<tr>
							<th></th>
							{{#each characteristicsList}}
							<th>{{this.name}}</th>
							{{/each}}
						</tr>
