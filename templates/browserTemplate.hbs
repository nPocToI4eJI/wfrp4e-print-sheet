				{{#if trappings}}{{createTrappingsElem trappings interactive=true}}{{/if}}
			</div>
		</div>
	</section>

	<section class="tab-section" data-section="magic">
		<div class="card magic-section" data-add-type="magic">
			<h3>{{localize "Magic"}} &amp; {{localize "Religion"}} <span class="badge">{{magics.length}}</span></h3>
			<div class="list-head magics">
				<span>{{localize "Name"}}</span>
				<span>{{localize "CN"}}</span>
				<span>{{localize "Range"}}</span>
				<span>{{localize "Target"}}</span>
				<span>{{localize "WFRP4E.PrintSheet.HTML.Duration"}}</span>
				<span>{{localize "Type"}}</span>
				<span></span>
			</div>
			<div class="content">
				{{#each magics as |magic|}}
				<div class="item magics tooltip-target" data-tooltip="{{magic.description}}" data-search="{{magic.name}} {{magic.lore}}">
					<div class="row-main">
						<div class="name-cell">
							{{#if magic.image}}<img class="item-icon" src="{{magic.image}}" alt="">{{/if}}
							<input id="magic.{{@index}}.name" value="{{magic.name}}">
						</div>
						<input id="magic.{{@index}}.cn" value="{{magic.cn}}">
						<input id="magic.{{@index}}.range" value="{{magic.range}}">
						<input id="magic.{{@index}}.target" value="{{magic.target}}">
						<input id="magic.{{@index}}.duration" value="{{magic.duration}}">
						<input id="magic.{{@index}}.lore" value="{{magic.lore}}">
						<button type="button" class="expand-btn" title="{{localize 'WFRP4E.PrintSheet.HTML.ExpandDetails'}}"><i class="fas fa-circle-info"></i></button>
					</div>
					<div class="inline-desc" hidden></div>
				</div>
				{{/each}}
			</div>
		</div>

		<div class="grid-2">
			<div class="card">
				<h3>{{localize "Personal Ambitions"}}</h3>
				<div class="stat-row"><span>{{localize "Short Term"}}</span><input id="status.ambitions.personal.short" value="{{status.ambitions.personal.short}}"></div>
				<div class="stat-row"><span>{{localize "Long Term"}}</span><input id="status.ambitions.personal.long" value="{{status.ambitions.personal.long}}"></div>
			</div>
			<div class="card">
				<h3>{{localize "Party Ambitions"}}</h3>
				<div class="stat-row"><span>{{localize "Short Term"}}</span><input id="status.ambitions.party.short" value="{{status.ambitions.party.short}}"></div>
				<div class="stat-row"><span>{{localize "Long Term"}}</span><input id="status.ambitions.party.long" value="{{status.ambitions.party.long}}"></div>
			</div>
		</div>

		<div class="grid-2">
			<div class="card">
				<h3>{{localize "Biography"}}</h3>
				<textarea id="details.biography">{{details.biography}}</textarea>
			</div>
			<div class="card exp-section" data-add-type="experience">
				<h3>{{localize "SHEET.ExperienceLog"}} <span class="badge">{{status.experience.log.length}}</span></h3>
				<div class="list-head experience">
					<span>{{localize "Experience"}}</span>
					<span>{{localize "Reason"}}</span>
				</div>
				<div class="content">
					{{#each status.experience.log as |experience|}}
					<div class="item experience" data-search="{{experience.reason}}">
						<div class="row-main">
							<input id="experience.{{@index}}.value" value="{{experience.value}}">
							<input class="col-rsn" id="experience.{{@index}}.reason" value="{{experience.reason}}">
						</div>
					</div>
					{{/each}}
				</div>
			</div>
		</div>
	</section>
</main>

<script type="application/json" id="props-data">{{{settings.propsJson}}}</script>
<script>
(() => {
	let debug = {{#if settings.debug}}true{{else}}false{{/if}};
	let debugMessage = ["%cWFRP4e - Print sheet %c[debug]%c.", "font-weight: bold;", "color: orange;", ""];
	let propsEl = document.getElementById("props-data");
	let props = {};
	try {props = JSON.parse(propsEl?.textContent || "{}")} catch {};
	let tooltip = document.getElementById("tooltip");
	let hoverTarget = null;
	let showTimer = null;
	let hideTimer = null;
	let mouseX = 0;
	let mouseY = 0;
	//Переключение вкладок
	let currentTab = document.querySelector(".nav-tab.active")?.dataset.tab || "all";
	function applyTab(tab) {
		currentTab = tab;
		document.querySelectorAll(".nav-tab").forEach(btn => btn.classList.toggle("active", btn.dataset.tab === tab));
		document.querySelectorAll(".tab-section").forEach(sec => {
			sec.hidden = tab !== "all" && sec.dataset.section !== tab;
		});
	};
	document.getElementById("navTabs").addEventListener("click", (e) => {
		let btn = e.target.closest(".nav-tab");
		if (btn) {
			let searchInput = document.getElementById("sheetSearch");
			if (searchInput.value) {
				searchInput.value = "";
				applySearch("");
			};
			applyTab(btn.dataset.tab);
		}
	});
	//Живой поиск по листу (скрывает пустые и несовпавшие блоки, оставляя шапку)
	function applySearch(rawQuery) {
		let q = String(rawQuery || "").trim().toLowerCase();
		if (!q) {
			document.querySelectorAll(".content > .item").forEach(item => { item.hidden = false; });
			document.querySelectorAll(".tab-section .card, .tab-section .grid-2, .tab-section .grid-3, .tab-section .grid-status").forEach(el => { el.hidden = false; });
			applyTab(currentTab);
			return;
		}
		document.querySelectorAll(".tab-section").forEach(sec => { sec.hidden = false; });
		document.querySelectorAll(".tab-section .card").forEach(card => {
			if (card.classList.contains("magic-section") && document.body.classList.contains("hide-magic")) { card.hidden = true; return; }
			if (card.classList.contains("sin-card") && document.body.classList.contains("hide-sin")) { card.hidden = true; return; }
			if (card.classList.contains("exp-section") && document.body.classList.contains("hide-exp")) { card.hidden = true; return; }
			let listContent = card.querySelector(":scope > .content");
			if (listContent) {
				let items = Array.from(listContent.querySelectorAll(":scope > .item"));
				let visibleCount = 0;
				for (let item of items) {
					let values = Array.from(item.querySelectorAll("input")).map(i => i.value).join(" ");
					let hay = `${item.dataset.search || ""} ${values}`.toLowerCase();
					let match = hay.includes(q);
					item.hidden = !match;
					if (match) {visibleCount++};
				};
				card.hidden = visibleCount === 0;
			} else {
				let textParts = [card.textContent || ""];
				card.querySelectorAll("input, textarea").forEach(f => textParts.push(f.value || ""));
				card.hidden = !textParts.join(" ").toLowerCase().includes(q);
			}
		});
		document.querySelectorAll(".tab-section .grid-2, .tab-section .grid-3, .tab-section .grid-status").forEach(grid => {
			grid.hidden = !grid.querySelector(".card:not([hidden])");
		});
		document.querySelectorAll(".tab-section").forEach(sec => {
			sec.hidden = !sec.querySelector(".card:not([hidden])");
		});
	};
	document.getElementById("sheetSearch").addEventListener("input", (e) => {
		applySearch(e.target.value);
	});
	//Переключатели разделов и режимов редактирования
	let modeIds = ["modeScale", "modeAdd", "modeDelete"];
	let syncToggles = () => {
		document.body.classList.toggle("no-tooltips", document.getElementById("toggleTooltips").checked);
		document.body.classList.toggle("hide-magic", document.getElementById("toggleMagic").checked);
		document.body.classList.toggle("hide-sin", document.getElementById("toggleSin").checked);
		document.body.classList.toggle("hide-exp", document.getElementById("toggleExp").checked);
		document.body.classList.toggle("mode-scale", document.getElementById("modeScale").checked);
		document.body.classList.toggle("mode-add", document.getElementById("modeAdd").checked);
		document.body.classList.toggle("mode-delete", document.getElementById("modeDelete").checked);
	};
	for (let id of modeIds) {
		document.getElementById(id).addEventListener("change", (e) => {
			if (e.target.checked) {
				for (let other of modeIds) {
					if (other !== id) {document.getElementById(other).checked = false};
				};
			};
			syncToggles();
		});
	};
	for (let id of ["toggleTooltips", "toggleMagic", "toggleSin", "toggleExp"]) {
		document.getElementById(id).addEventListener("change", () => {
			syncToggles();
			let q = document.getElementById("sheetSearch").value;
			if (q) {applySearch(q)};
		});
	};
	syncToggles();
	//Общее масштабирование шрифта
	let uiScale = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--ui-scale")) || 1;
	document.getElementById("btnScaleDown").addEventListener("click", () => {
		uiScale = Math.max(0.75, Math.round((uiScale - 0.05) * 100) / 100);
		document.documentElement.style.setProperty("--ui-scale", uiScale);
	});
	document.getElementById("btnScaleUp").addEventListener("click", () => {
		uiScale = Math.min(1.45, Math.round((uiScale + 0.05) * 100) / 100);
		document.documentElement.style.setProperty("--ui-scale", uiScale);
	});
	document.getElementById("btnPrint").addEventListener("click", () => window.print());
	//Живой пересчёт характеристик, навыков, веса и счётчиков в заголовках
	function round2(n) {return Math.round((Number(n) || 0) * 100) / 100};
	//Обновление числового счётчика в заголовке карточки при добавлении/удалении строк
	function updateCardBadge(card) {
		if (!card) {return};
		let badge = card.querySelector(":scope > h3 > .badge");
		let content = card.querySelector(":scope > .content");
		if (!badge || !content) {return};
		if (card.dataset.addType === "talent") {
			let traitsCount = content.querySelectorAll(":scope > .item.traits").length;
			let talentsCount = content.querySelectorAll(":scope > .item:not(.traits)").length;
			badge.textContent = traitsCount ? `${talentsCount} + ${traitsCount}` : String(talentsCount);
		} else {badge.textContent = String(content.querySelectorAll(":scope > .item").length)};
		if (debug) {
			console.debug(...debugMessage, "updateCardBadge", card.dataset.addType, badge.textContent);
		};
	};
	function recalcEncumbrance(sourceInput = null) {
		let wEl = document.getElementById("encumbrance.weapons");
		let aEl = document.getElementById("encumbrance.armours");
		let tEl = document.getElementById("encumbrance.trappings");
		let totEl = document.getElementById("encumbrance.current");
		if (!wEl || !aEl || !tEl || !totEl) {return};
		if (sourceInput && [wEl, aEl, tEl].includes(sourceInput)) {
			totEl.value = round2((parseFloat(wEl.value) || 0) + (parseFloat(aEl.value) || 0) + (parseFloat(tEl.value) || 0));
			return;
		};
		let sumSel = (sel) => round2(Array.from(document.querySelectorAll(sel)).reduce((s, inp) => s + (parseFloat(inp.value) || 0), 0));
		let wSum = sumSel(".item.weapons .col-enc");
		let aSum = sumSel(".item.armours .col-enc");
		let coinsTotal = (parseInt(document.getElementById("coins.gc")?.value) || 0)
			+ (parseInt(document.getElementById("coins.ss")?.value) || 0)
			+ (parseInt(document.getElementById("coins.bp")?.value) || 0);
		let coinsEnc = Math.floor(Math.max(0, coinsTotal) / 100);
		let tSum = round2(sumSel(".item.trappings:not(.layer) .col-enc") + coinsEnc);
		wEl.value = wSum;
		aEl.value = aSum;
		tEl.value = tSum;
		totEl.value = round2(wSum + aSum + tSum);
		if (debug) {
			console.debug(...debugMessage, "recalcEncumbrance", {weapons: wSum, armours: aSum, trappings: tSum, total: totEl.value});
		};
	};
	function recalcCharacteristic(charKey) {
		let init = parseInt(document.getElementById(`characteristics.${charKey}.initial`)?.value) || 0;
		let adv = parseInt(document.getElementById(`characteristics.${charKey}.advances`)?.value) || 0;
		let mod = parseInt(document.getElementById(`characteristics.${charKey}.modifier`)?.value) || 0;
		let cur = init + adv + mod;
		let curEl = document.getElementById(`characteristics.${charKey}.current`);
		let bonusEl = document.getElementById(`characteristics.${charKey}.bonus`);
		if (curEl) { curEl.value = cur; }
		if (bonusEl) { bonusEl.value = Math.floor(cur / 10); }
		document.querySelectorAll(".item.skills").forEach(row => {
			let sel = row.querySelector(".skill-char");
			if (sel && sel.value === charKey) {
				let cvalEl = row.querySelector(".skill-cval");
				let advEl = row.querySelector(".skill-adv");
				let totEl = row.querySelector(".skill-tot");
				if (cvalEl) { cvalEl.value = cur; }
				if (totEl) {totEl.value = cur + (parseInt(advEl?.value) || 0)};
			};
		});
	};
	document.addEventListener("input", (e) => {
		if (e.target.classList.contains("char-part")) {recalcCharacteristic(e.target.dataset.char)}
		else if (e.target.classList.contains("char-current")) {
			let charKey = e.target.dataset.char;
			let cur = parseInt(e.target.value) || 0;
			let bonusEl = document.getElementById(`characteristics.${charKey}.bonus`);
			if (bonusEl) {bonusEl.value = Math.floor(cur / 10)};
			document.querySelectorAll(".item.skills").forEach(row => {
				let sel = row.querySelector(".skill-char");
				if (sel && sel.value === charKey) {
					let cvalEl = row.querySelector(".skill-cval");
					let advEl = row.querySelector(".skill-adv");
					let totEl = row.querySelector(".skill-tot");
					if (cvalEl) {cvalEl.value = cur};
					if (totEl) {totEl.value = cur + (parseInt(advEl?.value) || 0)};
				};
			});
		} else if (e.target.classList.contains("skill-adv") || e.target.classList.contains("skill-cval")) {
			let row = e.target.closest(".item.skills");
			if (row) {
				let cval = parseInt(row.querySelector(".skill-cval")?.value) || 0;
				let adv = parseInt(row.querySelector(".skill-adv")?.value) || 0;
				let totEl = row.querySelector(".skill-tot");
				if (totEl) {totEl.value = cval + adv};
			};
		} else if (e.target.classList.contains("col-enc") || ["coins.gc", "coins.ss", "coins.bp"].includes(e.target.id)) {recalcEncumbrance()}
		else if (["encumbrance.weapons", "encumbrance.armours", "encumbrance.trappings"].includes(e.target.id)) {recalcEncumbrance(e.target)};
	});
	document.addEventListener("change", (e) => {
		if (e.target.classList.contains("skill-char")) {
			let row = e.target.closest(".item.skills");
			let cur = parseInt(document.getElementById(`characteristics.${e.target.value}.current`)?.value) || 0;
			let cvalEl = row?.querySelector(".skill-cval");
			let advEl = row?.querySelector(".skill-adv");
			let totEl = row?.querySelector(".skill-tot");
			if (cvalEl) {cvalEl.value = cur};
			if (totEl) {totEl.value = cur + (parseInt(advEl?.value) || 0)};
		};
	});
	//Всплывающие подсказки у курсора и раскрывающиеся описания
	function buildDetailsHtml(target) {
		let html = "";
		let qualInput = target.querySelector("input[data-type='qualities']");
		let qualStr = (qualInput ? qualInput.value : (target.dataset.qualities || "")).trim();
		if (qualStr) {
			let list = qualStr.split(/\s*,\s*/).filter(Boolean);
			if (list.length) {
				html += "<h4>{{localize 'Qualities'}} &amp; {{localize 'Flaws'}}</h4>";
				for (let q of list) {
					let base = q.replace(/\s+\d+$/, "").trim();
					html += `<p><strong>${q}</strong>: ${props[base] || props[q] || "<em>{{localize 'WFRP4E.PrintSheet.Empty'}}</em>"}</p>`;
				};
			};
		};
		if (target.dataset.tooltip) {html += target.dataset.tooltip};
		return html;
	};
	function positionTooltip(x, y) {
		let pad = 10;
		let offset = 14;
		tooltip.style.left = "0px";
		tooltip.style.top = "0px";
		let tw = tooltip.offsetWidth;
		let th = tooltip.offsetHeight;
		let left = x + offset;
		if (left + tw > window.innerWidth - pad) {left = Math.max(pad, x - tw - offset)};
		left = Math.max(pad, Math.min(left, window.innerWidth - tw - pad));
		let top = y + offset;
		if (top + th > window.innerHeight - pad) {top = Math.max(pad, y - th - offset)};
		tooltip.style.left = `${Math.round(left)}px`;
		tooltip.style.top = `${Math.round(top)}px`;
	};
	document.addEventListener("mousemove", (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
	});
	document.addEventListener("mouseover", (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
		if (document.body.classList.contains("no-tooltips") || document.body.classList.contains("mode-scale") || document.body.classList.contains("mode-add") || document.body.classList.contains("mode-delete")) { return; }
		let target = e.target.closest(".tooltip-target");
		if (!target || target === hoverTarget || target.classList.contains("expanded")) {return};
		hoverTarget = target;
		clearTimeout(hideTimer);
		clearTimeout(showTimer);
		showTimer = setTimeout(() => {
			if (hoverTarget !== target) {return};
			let content = buildDetailsHtml(target);
			if (!content) {return};
			tooltip.innerHTML = content;
			tooltip.classList.add("active");
			positionTooltip(mouseX, mouseY);
		}, 350);
	});
	document.addEventListener("mouseout", (e) => {
		let target = e.target.closest(".tooltip-target");
		if (!target || target.contains(e.relatedTarget)) {return};
		if (e.relatedTarget && tooltip.contains(e.relatedTarget)) {return};
		clearTimeout(showTimer);
		hoverTarget = null;
		hideTimer = setTimeout(() => {
			if (!hoverTarget) {tooltip.classList.remove("active")};
		}, 250);
	});
	tooltip.addEventListener("mouseenter", () => clearTimeout(hideTimer));
	tooltip.addEventListener("mouseleave", () => {
		hoverTarget = null;
		tooltip.classList.remove("active");
	});
	//Обработка кликов: кнопки +/-, раскрытие описаний, масштаб, добавление и удаление строк
	let charOptions = `
		<option value="ws" selected>{{localize "CHARAbbrev.WS"}}</option>
		<option value="bs">{{localize "CHARAbbrev.BS"}}</option>
		<option value="s">{{localize "CHARAbbrev.S"}}</option>
		<option value="t">{{localize "CHARAbbrev.T"}}</option>
		<option value="i">{{localize "CHARAbbrev.I"}}</option>
		<option value="ag">{{localize "CHARAbbrev.Ag"}}</option>
		<option value="dex">{{localize "CHARAbbrev.Dex"}}</option>
		<option value="int">{{localize "CHARAbbrev.Int"}}</option>
		<option value="wp">{{localize "CHARAbbrev.WP"}}</option>
		<option value="fel">{{localize "CHARAbbrev.Fel"}}</option>`;
	let rowTemplates = {
		skill: () => `<div class="item skills"><div class="row-main"><input class="col-name" value=""><select class="skill-char">${charOptions}</select><input class="skill-cval" value="0"><input class="skill-adv" value="0"><input class="skill-tot" value="0"><span></span></div><div class="inline-desc" hidden></div></div>`,
		talent: () => `<div class="item talents"><div class="row-main"><div class="name-cell"><input value=""></div><input value=""><input value=""><span></span></div><div class="inline-desc" hidden></div></div>`,
		armour: () => `<div class="item armours"><div class="row-main"><div class="name-cell"><input value=""></div><input value=""><input class="col-enc" value="0"><input data-type="qualities" value=""><span></span></div><div class="inline-desc" hidden></div></div>`,
		weapon: () => `<div class="item weapons"><div class="row-main"><div class="name-cell"><input value=""></div><input value=""><input class="col-enc" value="0"><input value=""><input value=""><input data-type="qualities" value=""><span></span></div><div class="inline-desc" hidden></div></div>`,
		trapping: () => `<div class="item trappings"><div class="row-main"><div class="name-cell"><input value=""></div><input class="col-enc" value="0"><span></span></div><div class="inline-desc" hidden></div></div>`,
		magic: () => `<div class="item magics"><div class="row-main"><div class="name-cell"><input value=""></div><input value=""><input value=""><input value=""><input value=""><input value=""><span></span></div><div class="inline-desc" hidden></div></div>`,
		experience: () => `<div class="item experience"><div class="row-main"><input value=""><input class="col-rsn" value=""></div></div>`,
		simple: () => `<div class="item simple"><div class="row-main"><div class="name-cell"><input value=""></div><span></span></div><div class="inline-desc" hidden></div></div>`
	};
	document.addEventListener("click", (e) => {
		let stepBtn = e.target.closest(".step-btn");
		if (stepBtn) {
			let inp = document.getElementById(stepBtn.dataset.target);
			if (inp) {
				let cur = parseInt(inp.value) || 0;
				inp.value = Math.max(0, cur + (parseInt(stepBtn.dataset.step) || 0));
				if (["coins.gc", "coins.ss", "coins.bp"].includes(inp.id)) {recalcEncumbrance()};
			};
			return;
		};
		let expBtn = e.target.closest(".expand-btn");
		if (expBtn) {
			let item = expBtn.closest(".item");
			let drawer = item?.querySelector(".inline-desc");
			if (item && drawer) {
				let willOpen = drawer.hidden;
				if (willOpen) {
					drawer.innerHTML = buildDetailsHtml(item) || "<em>{{localize 'WFRP4E.PrintSheet.Empty'}}</em>";
					tooltip.classList.remove("active");
				}
				drawer.hidden = !willOpen;
				item.classList.toggle("expanded", willOpen);
			}
			return;
		}
		if (document.body.classList.contains("mode-scale")) {
			let field = e.target.closest("input:not([type=checkbox]):not([type=search]), textarea");
			if (field) {
				let size = parseFloat(getComputedStyle(field).fontSize) || 14;
				field.style.fontSize = `${Math.min(30, size + 1)}px`;
				return;
			}
		}
		if (document.body.classList.contains("mode-delete")) {
			let row = e.target.closest(".content > .item");
			if (row) {
				let card = row.closest(".card");
				let affectsEnc = Boolean(row.querySelector(".col-enc"));
				row.remove();
				updateCardBadge(card);
				if (affectsEnc) {recalcEncumbrance()};
				return;
			};
		};
		if (document.body.classList.contains("mode-add")) {
			let heading = e.target.closest(".card[data-add-type] > h3");
			if (heading) {
				let card = heading.closest(".card");
				let type = card.dataset.addType;
				let container = card.querySelector(":scope > .content");
				if (container && rowTemplates[type]) {
					container.insertAdjacentHTML("beforeend", rowTemplates[type]());
					updateCardBadge(card);
				};
			};
		};
	});
	document.addEventListener("contextmenu", (e) => {
		if (!document.body.classList.contains("mode-scale")) { return; }
		let field = e.target.closest("input:not([type=checkbox]):not([type=search]), textarea");
		if (field) {
			e.preventDefault();
			let size = parseFloat(getComputedStyle(field).fontSize) || 14;
			field.style.fontSize = `${Math.max(8, size - 1)}px`;
		};
	});
	//Сохранение изменённого листа в новый HTML-файл
	document.getElementById("btnSave").addEventListener("click", () => {
		tooltip.classList.remove("active");
		document.getElementById("sheetSearch").value = "";
		applySearch("");
		for (let id of modeIds) {document.getElementById(id).checked = false};
		syncToggles();
		document.querySelectorAll("input").forEach(inp => {
			if (inp.type === "checkbox" || inp.type === "radio") {
				if (inp.checked) {inp.setAttribute("checked", "")}
				else {inp.removeAttribute("checked")};
			} else {inp.setAttribute("value", inp.value)};
		});
		document.querySelectorAll("textarea").forEach(ta => {ta.textContent = ta.value});
		document.querySelectorAll("select").forEach(sel => {
			Array.from(sel.options).forEach(opt => {
				if (opt.selected) {opt.setAttribute("selected", "")}
				else {opt.removeAttribute("selected")};
			});
		});
		let html = "<!DOCTYPE html>\n" + document.documentElement.outerHTML;
		let blob = new Blob([html], {type: "text/html;charset=utf-8"});
		let filename = decodeURIComponent(window.location.pathname.split("/").pop() || "");
		if (!filename || !filename.toLowerCase().endsWith(".html")) {
			filename = ((document.getElementById("name")?.value || "character-sheet").replace(/[\/|\\:*?"<>]/g, "_")) + ".html";
		}
		let a = document.createElement("a");
		let url = URL.createObjectURL(blob);
		a.href = url;
		a.download = filename;
		document.body.appendChild(a);
		a.click();
		setTimeout(() => { a.remove(); URL.revokeObjectURL(url); }, 100);
	});
})();
</script>
